rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(ownerId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == ownerId;
    }

    function privatePhoto(ownerId, slot) {
      return firestore.get(
        /databases/(default)/documents/users/$(ownerId)/photos/$(slot)
      );
    }

    function publicPhoto(ownerId, slot) {
      return firestore.get(
        /databases/(default)/documents/publicPhotos/$(ownerId + "_" + slot)
      );
    }

    function canCreateOriginal(ownerId, slot) {
      return isOwner(ownerId)
        && resource == null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        )
        && request.resource.metadata.keys().hasAll([
          'reservationId'
        ])
        && privatePhoto(ownerId, slot).data.status == 'reserved'
        && privatePhoto(ownerId, slot).data.reservationId
          == request.resource.metadata.reservationId
        && privatePhoto(ownerId, slot).data.originalContentType
          == request.resource.contentType
        && privatePhoto(ownerId, slot).data.originalSize
          == request.resource.size;
    }

    function isReadyPublicPhoto(ownerId, slot) {
      return firestore.exists(
        /databases/(default)/documents/publicPhotos/$(ownerId + "_" + slot)
      )
        && publicPhoto(ownerId, slot).data.status == 'ready';
    }

    function isDerivative(name) {
      return name == 'optimized.webp' || name == 'thumbnail.webp';
    }

    function publicSourceGeneration(ownerId, slot) {
      return publicPhoto(ownerId, slot).data.get('sourceGeneration', null);
    }

    match /photos/{ownerId}/{slot}/original {
      allow read: if isOwner(ownerId);
      allow create: if canCreateOriginal(ownerId, slot);
      allow update, delete: if false;
    }

    // Only the generation the public record points at is served.
    match /photos/{ownerId}/{slot}/{sourceGeneration}/{derivative} {
      allow read: if isDerivative(derivative)
        && isReadyPublicPhoto(ownerId, slot)
        && publicSourceGeneration(ownerId, slot) == sourceGeneration;
      allow write: if false;
    }

    // Unversioned layout of photos processed before derivatives were
    // versioned. Remove once no public record lacks sourceGeneration.
    match /photos/{ownerId}/{slot}/{derivative} {
      allow read: if isDerivative(derivative)
        && isReadyPublicPhoto(ownerId, slot)
        && publicSourceGeneration(ownerId, slot) == null;
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
